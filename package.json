{
  "name": "packetwise-ccna",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:pages": "ng build --base-href ./",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "package": "node scripts/package.mjs",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.mjs",
    "docs:sync": "node --experimental-strip-types scripts/sync-docs.mjs",
    "docs:check": "node --experimental-strip-types scripts/sync-docs.mjs --check",
    "coverage:check": "node --experimental-strip-types scripts/check-assessment-coverage.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "type": "module"
}
